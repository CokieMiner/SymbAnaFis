"""Private extension types; public users import the owning Python classes."""

from typing import Any, Callable, Iterable

class ParseError(ValueError):
    span: tuple[int, int] | None
    source: str
class RewriteError(ValueError): ...
class SimplifyError(ValueError): ...
class EvaluationError(ValueError): ...
class UncertaintyError(ValueError): ...

class _Number:
    def __init__(self, value: object) -> None: ...
    @staticmethod
    def complex(real: _Number, imaginary: _Number) -> _Number: ...
    def components(self) -> tuple[Any, Any]: ...
    def binary(self, operation: str, other: _Number) -> _Number: ...
    def negative(self) -> _Number: ...
    def equal(self, other: _Number) -> bool: ...
    def is_finite(self) -> bool: ...
    def is_real(self) -> bool: ...
    def is_zero(self) -> bool: ...
    def __str__(self) -> str: ...

class _Expr:
    def __init__(self, value: _Number) -> None: ...
    @staticmethod
    def constant(name: str) -> _Expr: ...
    @staticmethod
    def sum(values: Iterable[_Expr]) -> _Expr: ...
    @staticmethod
    def product(values: Iterable[_Expr]) -> _Expr: ...
    def binary(self, operation: str, other: _Expr) -> _Expr: ...
    def negative(self) -> _Expr: ...
    def derivative(self, variable: _Expr, order: int) -> _Expr: ...
    def gradient(self, variables: Iterable[_Expr]) -> list[_Expr]: ...
    @staticmethod
    def jacobian(outputs: Iterable[_Expr], variables: Iterable[_Expr]) -> list[list[_Expr]]: ...
    def hessian(self, variables: Iterable[_Expr]) -> list[list[_Expr]]: ...
    def children(self) -> list[_Expr]: ...
    def symbols(self) -> list[_Expr]: ...
    def symbol_id(self) -> int: ...
    def symbol_name(self) -> str | None: ...
    def number(self) -> _Number | None: ...
    def function(self) -> _Function | None: ...
    def kind(self) -> str: ...
    def derivative_metadata(self) -> tuple[_Expr, int] | None: ...
    def facts(self) -> list[tuple[str, bool | None]]: ...
    def node_count(self) -> int: ...
    def max_depth(self) -> int: ...
    def has_derivatives(self) -> bool: ...
    def equal(self, other: _Expr) -> bool: ...
    def hash(self) -> int: ...
    def format(self, notation: str) -> str: ...
    def map(self, callback: Callable[[_Expr], _Expr | None]) -> _Expr: ...
    def fold(self, initial: Any, callback: Callable[[Any, _Expr], Any]) -> Any: ...

class _Context:
    def __init__(self) -> None: ...
    def symb(self, name: str) -> _Expr: ...
    def get_symbol(self, name: str) -> _Expr | None: ...
    def symbol_names(self) -> list[str]: ...
    def remove_symbol(self, name: str) -> bool: ...
    def clear_symbols(self) -> None: ...
    def remove_function(self, name: str) -> bool: ...
    def get_function(self, name: str) -> _Function | None: ...
    def functions(self) -> list[_Function]: ...
    def reset(self) -> None: ...
    def id(self) -> int: ...
    def parse(self, source: str) -> _Expr: ...
    def register_function(self, name: str, arity: int, parameters: Iterable[_Expr],
                          body: _Expr | None, partials: list[tuple[int, _Expr]]) -> _Function: ...

class _Function:
    @staticmethod
    def builtin(name: str) -> _Function | None: ...
    def call(self, arguments: Iterable[_Expr]) -> _Expr: ...
    def name(self) -> str: ...
    def arity(self) -> tuple[int, int]: ...
    def equal(self, other: _Function) -> bool: ...

class _Pattern:
    @staticmethod
    def capture(name: str, properties: list[str]) -> _Pattern: ...
    @staticmethod
    def exact(expression: _Expr) -> _Pattern: ...
    @staticmethod
    def call(function: _Function, arguments: list[_Pattern]) -> _Pattern: ...
    def binary(self, operation: str, other: _Pattern) -> _Pattern: ...
    def negative(self) -> _Pattern: ...

class _Substitutions:
    def __init__(self, entries: list[tuple[_Expr, _Expr]]) -> None: ...
    def apply(self, expression: _Expr) -> _Expr: ...
    def __len__(self) -> int: ...

class _Rule:
    def __init__(self, pattern: _Pattern, replacement: _Pattern | Callable[[dict[str, _Expr]], _Expr]) -> None: ...
    def apply(self, expression: _Expr, match_limit: int | None,
              guard: Callable[[dict[str, _Expr]], bool] | None = None) -> _Expr: ...

class _Sequence:
    def __init__(self, preset: str, target: str, domain_safety: str,
                 limits: tuple[int, int, int, int, int], match_limit: int | None) -> None: ...
    def copy(self) -> _Sequence: ...
    def steps(self) -> list[str]: ...
    def then_builtin(self, name: str) -> None: ...
    def then_rule(self, rule: _Rule) -> None: ...
    def then_map(self, callback: Callable[[_Expr], _Expr | None]) -> None: ...
    def score_with(self, callback: Callable[[_Expr], int]) -> None: ...
    def simplify(self, expression: _Expr) -> tuple[_Expr, str, int]: ...

class _Evaluator:
    def __init__(self, expression: _Expr, parameters: Iterable[_Expr], backend: str) -> None: ...
    @staticmethod
    def direct(expression: _Expr, parameters: Iterable[_Expr], values: list[Any], backend: str) -> _Number | float: ...
    def evaluate(self, values: list[Any]) -> _Number | float: ...
    def evaluate_batch(self, columns: list[list[Any]], row_count: int) -> list[_Number] | list[float]: ...
    def copy(self) -> _Evaluator: ...
    def parameters(self) -> list[_Expr]: ...
    def instruction_count(self) -> int: ...
    def workspace_size(self) -> int: ...
    def disassemble(self) -> str: ...

class _CovarianceMatrix:
    def __init__(self, entries: list[list[_Expr]]) -> None: ...
    @staticmethod
    def diagonal(variances: list[_Expr]) -> _CovarianceMatrix: ...
    def dimension(self) -> int: ...
    def get(self, row: int, column: int) -> _Expr | None: ...

class _Uncertainty:
    @staticmethod
    def propagate(expression: _Expr, variables: Iterable[_Expr], covariance: _CovarianceMatrix) -> _Uncertainty: ...
    def expression(self) -> _Expr: ...
    def sensitivities(self) -> list[_Expr]: ...
    def variance(self) -> _Expr: ...
    def standard_deviation(self) -> _Expr: ...
    def relative(self) -> _Expr: ...
